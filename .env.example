# StartupBridge AI Tunisia - Environment Configuration
# Copy this file to .env and configure either GEMINI_API_KEY or GROQ_API_KEY.
# If neither is set, the server automatically operates in "demo" mode with verified local fallback answers.

# Google Gemini API Key (e.g. from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Alternative)
GROQ_API_KEY=your_groq_api_key_here

# Server Port (default: 5000)
PORT=5000
