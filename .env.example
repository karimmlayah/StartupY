# StartupBridge AI / Bidaya Tunisia - Environment Configuration
# Copy this file to .env and configure credentials.

# ====================================================================
# Frontend Configuration
# ====================================================================
VITE_API_URL=http://localhost:8000/api

# ====================================================================
# Django & PostgreSQL Backend Configuration
# ====================================================================
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DB_NAME=bidaya_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ====================================================================
# AI & RAG Guidance (NVIDIA NIM primary; Gemini/Groq fallbacks)
# ====================================================================
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=moonshotai/kimi-k3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ====================================================================
# ZEGOCLOUD Video Call Kit
# ====================================================================
ZEGO_APP_ID=your_zego_app_id
ZEGO_SERVER_SECRET=your_zego_server_secret
PORT=5000
