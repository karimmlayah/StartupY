# StartupBridge AI / Bidaya Tunisia - Environment Configuration
# Copy this file to .env and configure the credentials.
# If Supabase is not configured, the platform seamlessly defaults to local Demo Mode.

# ====================================================================
# Supabase Configuration
# ====================================================================
# Client-side variables (Safe for frontend exposure via Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_public_key

# Backend-only Privileged Variables (NEVER expose to frontend or git)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Comma-separated admin emails for dev seeding and initial privilege assignment
ADMIN_EMAILS=admin@bidaya.tn

# ====================================================================
# AI & RAG Guidance (Optional: Gemini or Groq)
# ====================================================================
# If neither is set, local fallback responses with Tunisian sources are used
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ====================================================================
# ZEGOCLOUD Video Call Kit
# ====================================================================
# Server-side token generation only (NEVER expose in frontend)
ZEGO_APP_ID=your_zego_app_id
ZEGO_SERVER_SECRET=your_zego_server_secret

# ====================================================================
# Express Backend Server
# ====================================================================
PORT=5000
